      "authorization_tx": "0x3ca16e6590a3ff1c9222ce97c089be76ac0736f650bede13f52c723787d0d2fe",
      "write_methods": [
        {
          "name": "set_authorized_writer",
          "args": ["writer: Address"],
          "returns": "void"
        },
        {
          "name": "record_score",
          "args": ["contributor: str", "score: uint256"],
          "returns": "void"
        },
        {
          "name": "set_score",
          "args": ["contributor: str", "score: uint256"],
          "returns": "void"
        }
      ],
      "view_methods": [
        {
          "name": "get_all_entries",
          "args": [],
          "returns": "str (JSON)"
        },
        {
          "name": "get_top",
          "args": ["n: uint256"],
          "returns": "str (JSON)"
        },
        {
          "name": "get_authorized_writer",
          "args": [],
          "returns": "str"
        }
      ]
    }
  },
  "verified_transactions": {
    "escrow_smoke_test": {
      "tx": "0xe5fd2c69f520988b0918eb431ad7a547451642c725dcfe404a94dd218705440c",
