{
  "network": "testnetBradbury",
  "rpc": "https://rpc-bradbury.genlayer.com",
  "chain_id": 4221,
  "explorer": "https://explorer-bradbury.genlayer.com",
  "architecture": "v4.2-native-gen-escrow-template-aware-eth-testnet-rails",
  "contracts": {
    "TaskManager": {
      "address": "0xFB837f3aC53AEdf9951580D04eFb1D2aacd46959",
      "deployment_tx": "0x260ec92850b2eec3374da50c403825df03e40f781cfd0975442bd14934f4f9cb",
      "version": "4.2.0",
      "authorized_submitter": "0xCCf03Aba1011CE2393eA8B762208e9bdd82123Bf",
      "authorization_tx": "0x87371878c429f7900357d9c7789c016da1e51740aee7e3e50f999e57f92eb694",
      "escrow": {
        "asset": "native GEN",
        "decimals": 18,
        "payout_rule": "first submission at or above the task threshold",
        "creator_withdrawal": "locked until winner or expiry",
        "settlement_grace_seconds": 86400
      },
      "write_methods": [
        {
          "name": "create_task",
          "payable": true,
          "args": [
            "title: str",
            "description: str",
            "criteria: str",
            "reward_points: uint256",
            "payout_threshold: uint256",
            "duration_seconds: uint256"
          ],
          "returns": "str (task_id)"
        },
        {
          "name": "reopen_task",
          "payable": true,
          "args": [
            "task_id: str",
            "payout_threshold: uint256",
            "duration_seconds: uint256"
          ],
          "returns": "void"
        },
        {
          "name": "refund_expired_task",
          "args": ["task_id: str"],
          "returns": "void"
        },
        {
          "name": "record_submission",
          "args": [
            "task_id: str",
            "sub_id: str",
            "worker: str",
            "submitted_at: uint256"
          ],
          "returns": "void"
        },
        {
          "name": "record_evaluation",
          "args": [
            "task_id: str",
            "sub_id: str",
            "worker: str",
            "score: uint256",
            "points_awarded: uint256"
          ],
          "returns": "void"
        },
        {
          "name": "record_withdrawal",
          "args": ["task_id: str", "sub_id: str"],
          "returns": "void"
        },
        {
          "name": "set_authorized_submitter",
          "args": ["submitter: Address"],
          "returns": "void"
        }
      ],
      "view_methods": [
        {
          "name": "get_task",
          "args": ["task_id: str"],
          "returns": "str (JSON)"
        },
        {
          "name": "get_task_escrow",
          "args": ["task_id: str"],
          "returns": "str (JSON)"
        },
        {
          "name": "get_task_stats",
          "args": ["task_id: str"],
          "returns": "str (JSON)"
        },
        {
          "name": "get_platform_stats",
          "args": [],
          "returns": "str (JSON)"
        },
        {
          "name": "get_task_count",
          "args": [],
          "returns": "uint256"
        },
        {
          "name": "get_contract_balance",
          "args": [],
          "returns": "uint256"
        }
      ]
    },
    "ProofOfImpact": {
      "address": "0xCCf03Aba1011CE2393eA8B762208e9bdd82123Bf",
      "deployment_tx": "0x199dfe1789f32e1c00c3aed5ade45b38916b09646c92ff044a93f8195fc629ca",
      "version": "4.2.0",
      "evidence_consensus": "strict_eq independent URL fetch followed by template-aware prompt_comparative scoring",
      "constructor_args": [
        "task_manager_address: Address",
        "leaderboard_address: Address"
      ],
      "write_methods": [
        {
          "name": "submit_work",
          "args": ["task_id: str", "work_url: str", "description: str"],
          "returns": "str (sub_id)"
        },
        {
          "name": "evaluate_submission",
          "args": ["sub_id: str"],
          "returns": "str (AI JSON result)"
        },
        {
          "name": "retry_task_settlement",
          "args": ["sub_id: str"],
          "returns": "void"
        },
        {
          "name": "withdraw_submission",
          "args": ["sub_id: str"],
          "returns": "void"
        },
        {
          "name": "set_task_manager_contract",
          "args": ["task_manager_address: Address"],
          "returns": "void"
        },
        {
          "name": "set_leaderboard_contract",
          "args": ["leaderboard_address: Address"],
          "returns": "void"
        }
      ],
      "view_methods": [
        {
          "name": "get_task",
          "args": ["task_id: str"],
          "returns": "str (proxied JSON from TaskManager)"
        },
        {
          "name": "get_submission",
          "args": ["sub_id: str"],
          "returns": "str (JSON)"
        },
        {
          "name": "get_submission_evaluation",
          "args": ["sub_id: str"],
          "returns": "str (JSON)"
        },
        {
          "name": "can_submit",
          "args": ["task_id: str", "worker: str"],
          "returns": "str (JSON)"
        },
        {
          "name": "get_platform_stats",
          "args": [],
          "returns": "str (JSON)"
        }
      ]
    },
    "GlobalLeaderboard": {
      "address": "0x552FA16bD9F9b9Bd2F6fDa577657033F01d505fB",
